// Собираем логи только контейнеров текущего compose-проекта (logger-test или logger-prod),
// чтобы логи прода не попадали в тестовый Loki и наоборот.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.app.receiver]
}

loki.process "app" {
  // JSON-логи приложения: level и logger становятся метками для фильтрации
  stage.json {
    expressions = { level = "level", logger = "logger" }
  }

  stage.labels {
    values = { level = "", logger = "" }
  }

  stage.static_labels {
    values = { env = sys.env("APP_ENV") }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

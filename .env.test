# Тестовая среда. Секреты фиктивные — файл можно коммитить.
COMPOSE_PROJECT_NAME=logger-test
APP_BUILD_TARGET=test
APP_ENV=test
LOG_LEVEL=DEBUG
ENABLE_DEBUG_ENDPOINTS=true

POSTGRES_DB=app

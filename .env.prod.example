# Скопируйте в .env.prod и замените секреты. .env.prod не коммитится.
COMPOSE_PROJECT_NAME=logger-prod
APP_BUILD_TARGET=prod
APP_ENV=prod
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING
ENABLE_DEBUG_ENDPOINTS=false

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

GRAFANA_ADMIN_PASSWORD=change-me
LOKI_RETENTION=720h
TEMPO_RETENTION=720h
PROMETHEUS_RETENTION=30d
# Трассировка: в проде сэмплируем долю запросов (ARG — доля от 0 до 1)
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
